// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String            @id @default(cuid())
  companyName          String
  subdomain            String            @unique
  logoUrl              String?
  primaryColor         String            @default("#7c3aed")
  secondaryColor       String            @default("#5b21b6")
  contactEmail         String?
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  subscriptionPlan        String            @default("trial")
  subscriptionStatus      String            @default("trial")
  trialEndsAt             DateTime?
  stockManagementEnabled  Boolean           @default(true)
  fireAlarmEnabled        Boolean           @default(false)
  patTestingEnabled        Boolean           @default(false)
  emergencyLightingEnabled Boolean           @default(false)
  createdAt                DateTime          @default(now())
  users                User[]
  sites                Site[]
  extinguishers        Extinguisher[]
  inspections          Inspection[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  serviceJobs          ServiceJob[]
  inspectionPhotos     InspectionPhoto[]
  serviceReports       ServiceReport[]
  inventoryItems       InventoryItem[]
  partUsages           PartUsage[]
  quotes               Quote[]
  fireAlarmSystems     FireAlarmSystem[]
  fireAlarmLogEntries  FireAlarmLogEntry[]
  fireAlarmCallPoints  FireAlarmCallPoint[]
  patAppliances           PATAppliance[]
  patTests                PATTest[]
  emergencyLuminaires     EmergencyLuminaire[]
  emergencyLightTests     EmergencyLightTest[]

  @@index([subdomain])
  @@index([stripeCustomerId])
  @@index([subscriptionStatus])
  @@map("Tenant")
}

model Site {
  id            String         @id @default(cuid())
  tenantId      String
  name          String         // e.g., "London Office", "Wales Warehouse"
  address       String?
  city          String?
  postcode      String?
  country       String?        @default("UK")
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  status        String         @default("active")
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extinguishers Extinguisher[]
  userSiteAccess UserSiteAccess[]
  fireAlarmSystems FireAlarmSystem[]
  patAppliances       PATAppliance[]
  emergencyLuminaires EmergencyLuminaire[]

  @@index([tenantId])
  @@map("Site")
}

model User {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  email             String    @unique
  passwordHash      String
  role              String
  status            String    @default("active")
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  siteAccess        UserSiteAccess[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, status])
  @@map("User")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("VerificationToken")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("PasswordResetToken")
}

model Extinguisher {
  id              String       @id @default(cuid())
  tenantId        String
  siteId          String?      // Optional - for multi-site support
  externalId      String?
  location        String
  building        String
  floor           String?
  type            String
  capacity        String?
  weight          String?      // Weight category (e.g., "2kg", "6kg", "9kg")
  manufacturer    String?
  model           String?
  serialNumber    String?
  installDate     DateTime?
  expiryDate      DateTime?
  lastInspection  DateTime?
  nextInspection  DateTime?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  status          String       @default("Active")
  condition       String       @default("Good")
  serviceType     String?
  inspector       String?
  notes           String?
  createdAt       DateTime     @default(now())
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  inspections     Inspection[]
  quotes          Quote[]
  quoteLines      QuoteLine[]  // Lines in bulk quotes referencing this extinguisher
  inspectionPhotos InspectionPhoto[] @relation("ExtinguisherPhotos")

  @@index([tenantId])
  @@index([siteId])
  @@index([tenantId, status])
  @@index([tenantId, nextInspection])
  @@index([tenantId, nextMaintenance])
  @@index([tenantId, expiryDate])
  @@map("Extinguisher")
}

model Inspection {
  id              String        @id @default(cuid())
  tenantId        String
  extinguisherId  String
  serviceDate     DateTime
  serviceType     String
  technician      String?
  condition       String
  notes           String?
  partsReplaced   String?
  nextServiceDate DateTime?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extinguisher    Extinguisher  @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)

  @@index([tenantId, extinguisherId])
  @@index([tenantId, serviceDate])
  @@index([tenantId, nextServiceDate])
  @@map("Inspection")
}

model Subscription {
  id                   String    @id @default(cuid())
  tenantId             String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("Subscription")
}

model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  stripeInvoiceId String?
  amount          Int
  status          String
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("Invoice")
}

model ServiceJob {
  id              String   @id @default(cuid())
  tenantId        String
  extinguisherId  String?
  location        String
  building        String
  type            String
  serviceType     String
  status          String   @default("pending")
  notes           String?
  scheduledDate   DateTime?
  completedDate   DateTime?
  technician      String?
  rawInput        String?
  structured      Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ServiceJob")
}

model InspectionPhoto {
  id             String        @id @default(cuid())
  tenantId       String
  extinguisherId String?
  inspectionId   String?
  url            String
  caption        String?
  uploadedBy     String?
  findings       Json?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extinguisher   Extinguisher? @relation("ExtinguisherPhotos", fields: [extinguisherId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([extinguisherId])
  @@map("InspectionPhoto")
}

model ServiceReport {
  id         String   @id @default(cuid())
  tenantId   String
  visitDate  DateTime
  technician String?
  jobIds     String[]
  pdfUrl     String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ServiceReport")
}

model InventoryItem {
  id               String      @id @default(cuid())
  tenantId         String
  partNumber       String      // e.g., "SEAL-001", "VALVE-CO2"
  partName         String      // e.g., "O-Ring Seal", "CO2 Valve"
  category         String?     // e.g., "Seals", "Valves", "Gauges", "Hoses"
  description      String?
  unitPrice        Float?      // Cost per unit (internal cost)
  customerPrice    Float?      // Price charged to customers
  quantityInStock  Int         @default(0)
  minStockLevel    Int         @default(10) // Alert when below this
  supplier         String?
  supplierPartNo   String?
  location         String?     // Storage location
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usages           PartUsage[]
  quoteLines       QuoteLine[]

  @@unique([tenantId, partNumber])
  @@index([tenantId])
  @@map("InventoryItem")
}

model PartUsage {
  id              String        @id @default(cuid())
  tenantId        String
  inventoryItemId String
  extinguisherId  String?       // Optional - link to extinguisher
  inspectionId    String?       // Optional - link to inspection
  quantityUsed    Int
  usedBy          String?       // Technician name
  usedAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([extinguisherId])
  @@map("PartUsage")
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  endpoint     String   @unique
  p256dh       String   // Public key
  auth         String   // Auth secret
  deviceName   String?  // Browser/device identifier
  createdAt    DateTime @default(now())
  lastUsed     DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("PushSubscription")
}

model UserSiteAccess {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
  @@map("UserSiteAccess")
}

model Quote {
  id              String       @id @default(cuid())
  tenantId        String
  extinguisherId  String?      // Optional for bulk quotes (multiple extinguishers)
  inspectionId    String?      // Link to the inspection that triggered it
  quoteNumber     String       // Q-2026-0001
  status          String       @default("draft") // draft, sent, accepted, rejected, expired
  isBulkQuote     Boolean      @default(false) // True if quote covers multiple extinguishers
  validUntil      DateTime
  subtotal        Float        @default(0)
  vatRate         Float        @default(20) // VAT percentage
  vatAmount       Float        @default(0)
  totalAmount     Float        @default(0)
  notes           String?
  termsConditions String?
  createdBy       String?      // User name or email
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sentAt          DateTime?    // When quote was sent to customer
  acceptedAt      DateTime?    // When quote was accepted
  rejectedAt      DateTime?    // When quote was rejected

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extinguisher    Extinguisher? @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  lines           QuoteLine[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([extinguisherId])
  @@index([tenantId, status])
  @@map("Quote")
}

model QuoteLine {
  id              String         @id @default(cuid())
  quoteId         String
  extinguisherId  String?        // For bulk quotes - which extinguisher this line belongs to
  inventoryItemId String?        // If it's a part from inventory
  description     String         // Description of work/part
  quantity        Float          @default(1)
  unitPrice       Float          // Customer price
  lineTotal       Float          // quantity × unitPrice
  isLabour        Boolean        @default(false)
  sortOrder       Int            @default(0) // For ordering lines

  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  extinguisher    Extinguisher?  @relation(fields: [extinguisherId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([extinguisherId])
  @@map("QuoteLine")
}

// ─── Fire Alarm Logbook ───────────────────────────────────────────────────────

model FireAlarmSystem {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  systemRef   String   // User-defined ID e.g. "Panel A", "FAP-01"
  name        String?  // Optional friendly name
  panelMake   String?
  panelModel  String?
  panelSerial String?
  arcCompany  String?
  arcNumber   String?  // ARC reference/line number
  installDate DateTime?
  notes             String?
  nextWeeklyDue     DateTime?
  nextMonthlyDue    DateTime?
  nextQuarterlyDue  DateTime?
  nextSixMonthlyDue DateTime?
  nextAnnualDue     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  callPoints  FireAlarmCallPoint[]
  logEntries  FireAlarmLogEntry[]

  @@index([tenantId])
  @@index([siteId])
  @@map("FireAlarmSystem")
}

model FireAlarmCallPoint {
  id           String    @id @default(cuid())
  tenantId     String
  systemId     String
  pointRef     String    // e.g. "MCP-001", "Zone 1 - Lobby"
  location     String?
  floor        String?
  zone         String?
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  system  FireAlarmSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([tenantId])
  @@map("FireAlarmCallPoint")
}

model FireAlarmLogEntry {
  id           String   @id @default(cuid())
  tenantId     String
  systemId     String
  entryType    String   // 'weekly'|'monthly'|'quarterly'|'six_monthly'|'annual'|'non_routine'
  conductedBy  String
  conductedAt  DateTime
  outcome      String   // 'pass'|'fail'|'advisory'
  notes        String?
  data         Json?    // Type-specific checklist/fields (see service for shape)
  createdAt    DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  system  FireAlarmSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([systemId])
  @@index([entryType])
  @@map("FireAlarmLogEntry")
}

// ─── PAT Testing ─────────────────────────────────────────────────────────────

model PATAppliance {
  id             String    @id @default(cuid())
  tenantId       String
  siteId         String
  applianceRef   String    // ID No. e.g. "ID001"
  description    String    // e.g. "Kettle"
  location       String    // e.g. "Kitchen"
  applianceClass String?   // "I" or "II"
  notes          String?
  lastTestedAt   DateTime?
  nextTestDue    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tests          PATTest[]

  @@index([tenantId])
  @@index([siteId])
  @@map("PATAppliance")
}

model PATTest {
  id              String    @id @default(cuid())
  tenantId        String
  applianceId     String
  testedBy        String
  testedAt        DateTime
  visualInspect   String    // "pass" | "fail"
  earthOhms       Float?
  insulationMohms Float?
  functionalCheck String    // "pass" | "fail" | "na"
  outcome         String    // "pass" | "fail"
  nextTestDate    DateTime?
  comments        String?
  reportRef       String?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appliance       PATAppliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([applianceId])
  @@map("PATTest")
}

// ─── Emergency Lighting ───────────────────────────────────────────────────────

model EmergencyLuminaire {
  id                 String    @id @default(cuid())
  tenantId           String
  siteId             String
  luminaireRef       String    // Location identity e.g. "EL-001"
  description        String    // e.g. "Non-Maintained LED"
  location           String    // e.g. "Main Corridor"
  luminaireType      String    // "escape_route" | "open_area" | "high_risk" | "stairwell"
  fittingType        String?   // "self_contained" | "central_battery"
  zone               String?
  notes              String?
  nextDailyDue       DateTime?
  nextMonthlyDue     DateTime?
  nextAnnualDue      DateTime?
  nextThreeYearlyDue DateTime?
  lastTestedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tests              EmergencyLightTest[]

  @@index([tenantId])
  @@index([siteId])
  @@map("EmergencyLuminaire")
}

model EmergencyLightTest {
  id              String    @id @default(cuid())
  tenantId        String
  luminaireId     String
  testType        String    // "daily" | "monthly" | "annual" | "three_yearly"
  testedBy        String
  testedAt        DateTime
  durationSecs    Int?      // Monthly: target 30+ seconds
  durationMins    Int?      // Annual: 180 (escape route) or 60 (open area) minutes
  luxReading      Float?    // Optional lux reading
  outcome         String    // "pass" | "fail"
  defectsFound    String?
  remedialAction  String?
  nextTestDate    DateTime?
  comments        String?
  reportRef       String?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  luminaire       EmergencyLuminaire @relation(fields: [luminaireId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([luminaireId])
  @@map("EmergencyLightTest")
}
