{
  "expo": {
    "name": "FireXCheck",
    "slug": "firexcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "firexcheck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ignistech.firexcheck",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "FireXCheck needs camera access to scan QR codes on fire safety equipment.",
        "NSPhotoLibraryUsageDescription": "FireXCheck needs photo library access to attach evidence photos to inspections."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1917"
      },
      "package": "com.ignistech.firexcheck"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1917"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "FireXCheck needs camera access to scan QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "apiUrl": "https://firexcheck.com/api/v1"
    }
  }
}
