# Use Node.js 20 base image (NOT alpine, we need full apt-get support for Chrome)
# Updated: 2025-11-26 - Force rebuild to include filtering feature
FROM node:20-slim

# Cache-busting argument to force rebuild of frontend layers
ARG CACHEBUST=9

# Install Chrome and dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    --no-install-recommends \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && sh -c 'echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Verify Chrome installation
RUN google-chrome-stable --version

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (skip Puppeteer's Chromium download since we have Chrome)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN npm install

# Copy prisma schema
COPY prisma ./prisma/

# Generate Prisma Client with dummy DATABASE_URL (only for this build step)
RUN DATABASE_URL="postgresql://user:pass@host:5432/db" npx prisma generate

# Cache bust to force fresh copy of source code
RUN echo "Forcing fresh copy: $CACHEBUST"

# Copy source code
COPY . .

# Remove any .env files that might have been copied despite .dockerignore
RUN rm -f .env .env.* || true

# Build the application
RUN npm run build:backend

# Verify build output
RUN ls -la dist/src/ && echo "Build successful - dist/src/main.js exists"

# Build frontend
WORKDIR /app/frontend

# Force cache invalidation - rebuild frontend with filtering feature
# Updated: 2025-11-28 - Critical fix: Remove gitignore tracked node_modules
ARG BUILD_DATE
RUN echo "Build timestamp: $(date -u +%Y%m%d_%H%M%S)"
RUN echo "Cache bust: $CACHEBUST - Building frontend with latest code..."

# Verify source files exist before building
RUN echo "=== Checking frontend source files ===" && \
    ls -la src/pages/ && \
    echo "=== OverviewPage.tsx lines 20-30 (MUST show buildingFilter, typeFilter, statusFilter, conditionFilter) ===" && \
    sed -n '20,30p' src/pages/OverviewPage.tsx && \
    echo "=== UsersPage.tsx lines 92-112 ===" && \
    sed -n '92,112p' src/pages/UsersPage.tsx

# CRITICAL: Remove any existing dist/node_modules that might have been copied
# The .gitignore was fixed but Docker cache might still have old files
RUN echo "=== Cleaning all frontend build artifacts ===" && \
    rm -rf node_modules dist .vite package-lock.json && \
    echo "=== Installing fresh dependencies ===" && \
    npm cache clean --force && \
    npm install && \
    echo "=== Building frontend (should generate NEW hash) ===" && \
    npm run build && \
    echo "=== Checking public folder before copy ===" && \
    ls -la public/ && \
    echo "=== Manually copying policy files to dist ===" && \
    cp -v public/*.html dist/ && \
    echo "=== Verifying files were copied ===" && \
    ls -la dist/*.html

# Verify frontend build output
RUN ls -la dist/ && \
    echo "=== Frontend build successful - checking files ===" && \
    find dist -type f | head -20 && \
    echo "=== Policy HTML files (MUST exist for footer links) ===" && \
    ls -lh dist/*.html && \
    echo "=== index.html content (checking JS bundle reference) ===" && \
    cat dist/index.html && \
    echo "=== JS bundle files in assets ===" && \
    ls -lh dist/assets/*.js

# Return to app root
WORKDIR /app

# Set environment variables
ENV NODE_ENV=production
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Expose port (Railway will override with PORT env var, but we expose a default)
EXPOSE 8080

# Start command with Chrome verification
CMD ["sh", "-c", "echo 'Chrome version:' && google-chrome-stable --version && echo 'PUPPETEER_EXECUTABLE_PATH='$PUPPETEER_EXECUTABLE_PATH && npx prisma db push --accept-data-loss && node dist/src/main"]
